# Megabit Exchange configuration. Copy to .env and adjust.

# Public address of the platform, without a trailing slash. Used for cookies, the allowed origin
# and the page Revolut sends customers back to after paying.
PUBLIC_URL=https://megabit.example.com
# Domain for the Caddy reverse proxy in docker-compose (automatic HTTPS). Must match PUBLIC_URL.
DOMAIN=megabit.example.com

# HTTP server
PORT=3000
HOST=0.0.0.0
# Set to true when running behind a reverse proxy (Caddy, nginx).
TRUST_PROXY=true
# defaults to true when PUBLIC_URL starts with https://
# COOKIE_SECURE=true
# extra origins allowed to call the API, comma separated
# ALLOWED_ORIGINS=

# Storage (SQLite file on a persistent volume; back it up)
DATABASE_PATH=./data/megabit.db
# how long public trade history is kept
RETENTION_DAYS=30

# Accounts
REGISTRATION_OPEN=true
SESSION_DAYS=30
# Links shown next to the consent checkboxes at checkout (your own pages)
TERMS_URL=
PRIVACY_URL=

# ---- Paid accounts ----
# revolut: Revolut Merchant API (Revolut Business account with online payments)
# manual:  customers pay to your Revolut.me link with a reference; confirm with `npm run admin -- confirm <reference>`
# none:    no fee, accounts are active right away (development / private demos)
PAYMENT_PROVIDER=revolut
ACCOUNT_FEE=9.99
ACCOUNT_FEE_CURRENCY=USD
# virtual dollars credited per paid package
PACKAGE_USD=10000
# allow buying more packages after activation
TOPUP_ENABLED=true

# Revolut Merchant API (Revolut Business > Merchant > APIs)
# sandbox | production
REVOLUT_ENV=sandbox
# sk_... (keep it secret, server only)
REVOLUT_SECRET_KEY=
# wsk_... printed by `npm run revolut:webhook`
REVOLUT_WEBHOOK_SECRET=
REVOLUT_API_VERSION=2025-12-04

# Manual Revolut.me payments (PAYMENT_PROVIDER=manual)
MANUAL_PAYMENT_URL=https://revolut.me/yourname
MANUAL_PAYMENT_RECIPIENT=@yourname

# ---- Trading rules ----
MIN_ORDER_MB=100
# 0.20 % per trade
FEE_RATE=0.002
# minimum fee for orders that take liquidity
FEE_MIN_USD=0.05
# limit prices within +/-10 % of the index price
PRICE_BAND=0.10
MAX_ORDER_MB=50000000
MAX_OPEN_ORDERS=50
# platform sells new megabits at index price * (1 + premium)
ISSUE_PREMIUM=0
# platform buys megabits back at index price * (1 - discount)
REDEEM_DISCOUNT=0.02
REDEEM_ENABLED=true

# ---- Global Transfer Index ----
# simulated | cloudflare (shape of real global traffic from Cloudflare Radar; data is CC BY-NC 4.0)
GWT_SOURCE=simulated
CLOUDFLARE_API_TOKEN=

# ---- Network news (RSS/Atom feeds in content/feeds.json) ----
NEWS_FETCH=true
NEWS_REFRESH_MINUTES=30
